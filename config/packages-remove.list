# ============================================================================
#  Список пакетов для УДАЛЕНИЯ из базовой сборки Linux Mint.
#  По одному имени в строке. Символом # начинается комментарий.
#
#  ВНИМАНИЕ: apt удалит пакет вместе с тем, что от него зависит.
#  Старайтесь добавлять в список верхнеуровневые пакеты (метапакеты),
#  чтобы не оставалось "осиротевших" библиотек.
#  Проверить, что подтянется:  apt-get -s remove <имя>
# ============================================================================

# Примеры (раскомментируйте нужные строки):

# --- Игры из базовой поставки ---
#gnome-mines
#gnome-sudoku
#gnome-mahjongg
#quadrapassel
#tali
#four-in-a-row
#gnome-chess
#sgt-puzzles
#aisleriot

# --- Office (удаляет весь LibreOffice - освобождает ~1 ГБ) ---

#libreoffice-core
#libreoffice-writer
#libreoffice-base-calc

# --- Прочее (примеры) ---
#transmission-gtk
#pix
#gufw

#firefox
#thunderbird
